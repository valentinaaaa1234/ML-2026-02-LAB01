# Entorno y secretos
.env
.conda/
.venv/
venv/

# Entorno cursor
# Cursor (local)
.cursor/
.cursorrules
*.plan.md
.cursorignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# HTML crudo: ~16 MB que se regeneran con `python main.py capturar`.
# Los entregables piden URLs, texto procesado y JSON generado, no el HTML
# original, asi que se deja fuera del repositorio por peso.
data/raw/*.html
!data/raw/.gitkeep

# NOTA: data/processed/*.txt, data/json/*.json y obsidian_vault/**/*.md
# estaban excluidos en la version inicial de este archivo. Se versionan a
# proposito: el texto procesado, el JSON generado y el vault de Obsidian
# son entregables explicitos del laboratorio.

# Estado local de la ventana de Obsidian (pestanas abiertas, tamanos).
# Cambia en cada maquina y no es parte del conocimiento generado.
obsidian_vault/.obsidian/workspace.json

# Material docente local (no subir a GitHub)
docs/

# Sistema
.DS_Store
*.swp
